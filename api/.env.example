# Backend de Portería — variables de entorno (cargar en Render → Environment, nunca en el repo)

# Conexión a la base de Supabase (Project Settings → Database → Connection string, modo "Session pooler")
DATABASE_URL=

# Mismo proyecto de Supabase que usa el front (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Orígenes permitidos (CORS), separados por coma
CORS_ORIGINS=https://crf-central-mantenimiento-app.vercel.app,http://localhost:3000

# Clave del backup semanal (la misma que va en las Script properties del Apps Script)
BACKUP_KEY=

# Clave extra para DELETE /api/registros/purge (además de ser admin). Si se deja vacía, el borrado total queda deshabilitado.
ADMIN_KEY=
